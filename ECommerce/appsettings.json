{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Error",
        "Microsoft": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp} [{Level}] - Message : {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Data Source=.\\sqlexpress;Initial Catalog=Ecommerce;Integrated Security=True;Trust Server Certificate=True",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnectionString": "Data Source=.\\sqlexpress;Initial Catalog=Ecommerce;Integrated Security=True;Trust Server Certificate=True"
  },
 
    "Jwt": {
      "Audience": "User",
      "Issuer": "https://localhost:44357/",
      "Secret": "yitOTUoutoiTOIToitRXWwIYROIUoiTIYEue"
    }
  

}
